{
  "testCommand": "node --test \"acceptance/*.test.js\" \"test/*.test.js\"",
  "timeoutMs": 240000,
  "minTests": 30,
  "srcDirs": ["src"],
  "coverage": { "minLines": 80, "minFileLines": 60, "exclude": [] },
  "testQuality": { "dirs": ["test"], "minAssertionsPerFile": 3 },
  "holdout": { "command": "node --test \"${HARNESS_HIDDEN_DIR:-holdout}/*.test.js\"", "minTests": 8 },
  "mutation": { "samples": 8, "minKillRate": 0.6, "copy": ["src","test","acceptance"], "timeoutMs": 120000 }
}
