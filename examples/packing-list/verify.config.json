{
  "testCommand": "node --test \"acceptance/*.test.js\" \"tests/*.test.js\"",
  "timeoutMs": 240000,
  "minTests": 45,
  "srcDirs": ["src"],
  "coverage": { "minLines": 80, "minFileLines": 60, "exclude": [] },
  "testQuality": { "dirs": ["tests"], "minAssertionsPerFile": 3 },
  "holdout": { "command": "node --test \"${HARNESS_HIDDEN_DIR:-holdout}/*.test.js\"", "minTests": 25 },
  "journeys": { "command": "node --test \"journeys/*.test.js\"", "uxFile": "../../docs/product/packing-list/ux.md", "minTests": 25 },
  "mutation": { "samples": 8, "minKillRate": 0.6, "copy": ["src", "public", "tests", "acceptance", "package.json"], "timeoutMs": 120000 }
}
